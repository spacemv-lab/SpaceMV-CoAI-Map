// Prisma schema for the API service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum GeometryType {
  POINT
  LINESTRING
  POLYGON
  MULTI_POINT
  MULTI_LINESTRING
  MULTI_POLYGON
  RASTER
  UNKNOWN
}

// 数据导入状态机
enum IngestStatus {
  PENDING     // 等待处理
  PARSING     // 解析中
  VALIDATING  // 校验中
  IMPORTING   // 导入中
  INDEXING    // 构建索引中
  SUCCESS     // 成功
  FAILED      // 失败
}

// 映射类型（用于 CSV/XLSX 列映射）
enum MappingType {
  DIRECT      // 直接映射
  EXPRESSION  // 表达式转换
  LOOKUP      // 查找表映射
  CUSTOM      // 自定义函数
}

// 数据集作用域
enum DatasetScope {
  GLOBAL   // 全局数据广场，所有工程可用
  PROJECT  // 工程私有数据，仅该工程可用
}

// ============================================
// Models
// ============================================

// 项目：用于隔离不同业务场景的数据
model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  ownerId     String
  externalId  String?   @unique // 外部系统唯一标识（用于系统外部数据源）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  datasets    Dataset[]
  state       ProjectState?
  shares      ProjectShare[] @relation("ProjectShares")
  whiteboard  WhiteboardDoc?
}

// 项目公开分享链接：匿名、只读、可嵌入的地图分享
model ProjectShare {
  id         String     @id @default(uuid())
  token      String     @unique // url-safe 随机 token，≥24 字节熵
  projectId  String
  project    Project    @relation("ProjectShares", fields: [projectId], references: [id], onDelete: Cascade)
  label      String? // 自由备注，如 "wendao 文章 X"
  createdAt  DateTime   @default(now())
  revokedAt  DateTime? // 撤销时间；非空表示已失效
  expiresAt  DateTime? // 可选过期时间
  viewCount  Int        @default(0) // 成功加载次数（非唯一访客）

  @@index([projectId])
}

// 项目状态：存储地图视图状态和图层配置
model ProjectState {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewport    Json     // { center: [lng, lat], zoom, heading, pitch }
  basemap     String   @default("tianditu")
  layers      Json     // LayerState 数组（含 Draw GeoJSON 数据）
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// 项目白板：一站式配图（tldraw 画布文档）
// 一个项目一份 tldraw 文档（内部已支持多页），document 存 editor.getSnapshot()（含 base64 地图截图）
model WhiteboardDoc {
  id             String   @id @default(uuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document       Json     // tldraw getSnapshot()
  previewDataUrl String?  // 发布的预览图 PNG dataURL，供其他服务经 GET .../whiteboard/image 取用
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
}

// 白板模板：保存的画板快照（shapes + assets）+ 名称 + 缩略图，所有登录用户共享可见，owner 可删。
// 不挂 Project（跨项目共享）；content 与 thumbnailUrl 均自包含（JSON / dataURL），无外部依赖。
model WhiteboardTemplate {
  id           String   @id @default(uuid())
  name         String
  ownerId      String                          // 创建者 userId（删除权限依据）
  content      Json     // { assets: TLAsset[], shapes: TLShape[] } captureTemplateSnapshot 产物
  thumbnailUrl String?  // 缩略图 JPEG dataURL（与 WhiteboardDoc.previewDataUrl 同机制）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

// 瓦片源：天地图 token（kind='tianditu'）/ GeoTIFF COG（kind='titiler-cog'，二期）/ 通用 XYZ/WMTS（二期）
// credential 加密存第三方 token（AES-256-GCM，密钥 TILE_SOURCE_ENCRYPTION_KEY），仅 owner 可解
// tianditu「每用户一份」由 service 层 upsert 保证（不在模型层 unique，以免挡住二期一人多 COG 源）
model TileSource {
  id         String       @id @default(uuid())
  name       String
  scope      DatasetScope @default(GLOBAL)
  ownerId    String
  kind       String   // 'tianditu' | 'titiler-cog' | 'xyz' | 'wmts'
  config        Json
  credential    Json?
  objectKey     String?   // kind=titiler-cog:MinIO 对象 key(转码前=原档,转码后=COG)
  // COG 转码状态(仅 kind='titiler-cog' 用;tianditu 恒 READY)
  // PENDING(刚上传)→ PROCESSING(转码中)→ READY / FAILED
  ingestStatus  String   @default("READY")
  statusMessage String?
  createdAt     DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, ownerId])
  @@index([ownerId, kind])
}

// 数据集：逻辑上的数据集合
model Dataset {
  id               String           @id @default(uuid())
  projectId        String?          // 可选，全局数据无 projectId
  scope            DatasetScope     @default(PROJECT) // 默认为工程私有
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  type             GeometryType
  source           String // 来源：UPLOAD, SYNC, IMPORT
  externalId       String?          @unique // 外部系统唯一标识（用于系统外部数据源）
  tags             String[]
  description      String?
  style            Json?    // 样式配置：{ color, pointSize, opacity, ... }
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  versions         DatasetVersion[] @relation("DatasetVersions")
  currentVersion   DatasetVersion?  @relation("DatasetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  currentVersionId String?          @unique
  mappingProfiles  MappingProfile[]
  fields           DatasetField[]   // 字段定义（解析时提取）

  @@index([scope])
  @@index([projectId])
}

// 数据集字段定义（解析时提取）
model DatasetField {
  id          String   @id @default(uuid())
  datasetId   String
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name        String   // 字段名（原始）
  alias       String?  // 显示别名（可编辑）
  type        String   // string, number, boolean, date, unknown
  nullable    Boolean  @default(true)
  sampleValue Json?    // 首条数据的样例值（可选，用于调试）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([datasetId, name])  // 同一数据集内字段名唯一
  @@index([datasetId])
}

// 数据集版本：每次上传/更新生成一个新版本
model DatasetVersion {
  id                String            @id @default(uuid())
  datasetId         String
  dataset           Dataset           @relation("DatasetVersions", fields: [datasetId], references: [id], onDelete: Cascade)
  version           Int               @default(1)
  filePath          String // 原始文件存储路径
  fileSize          Int // 字节数
  recordCount       Int               @default(0) // 要素数量
  uploadedBy        String?
  status            IngestStatus      @default(PENDING)
  statusMessage     String? // 状态描述/错误信息
  sourceCRS         String? // 源坐标系 EPSG 代码
  targetCRS         String? // 目标坐标系 EPSG 代码
  bbox              Json? // 边界范围 [minX, minY, maxX, maxY]
  mappingProfileId  String? // 关联的映射配置
  mappingProfile    MappingProfile?   @relation(fields: [mappingProfileId], references: [id], onDelete: SetNull)
  validationReport  ValidationReport?
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  features          GisFeature[]
  currentVersionFor Dataset?          @relation("DatasetCurrentVersion")

  @@index([datasetId])
  @@index([status])
  @@unique([datasetId, version]) // 防止并发同步产生重复版本号
}

// 具体的空间要素数据
model GisFeature {
  id         String           @id @default(uuid())
  versionId  String
  version    DatasetVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  properties Json // 存储非几何属性
  geometry   Unsupported("geometry")? // PostGIS 字段

  @@index([versionId])
}

// 校验报告
model ValidationReport {
  id              String   @id @default(uuid())
  versionId       String   @unique
  version         DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  isValid         Boolean  @default(true)
  errorCount      Int      @default(0)
  warningCount    Int      @default(0)
  geometryErrors  Json? // [{featureId, errorType, message}]
  attributeErrors Json? // [{field, errorType, message}]
  summary         String? // 校验总结
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([versionId])
}

// 映射配置：定义 CSV/XLSX 列到目标字段的映射规则
model MappingProfile {
  id          String   @id @default(uuid())
  datasetId   String
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sourceType  String // CSV, XLSX, GEOJSON, SHAPEFILE
  mappings    Json // [{sourceColumn, targetField, mappingType, expression, defaultValue}]
  crs         String? // 默认坐标系
  geometryColumn String? // 几何列名（WKT/GeoJSON 列）
  geometryType String? // 几何类型
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    DatasetVersion[]

  @@index([datasetId])
}
