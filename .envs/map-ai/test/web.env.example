# 内网测试环境 - 前端 Web 配置模板
# 用途：内网测试环境部署

# 环境标识
VITE_DEPLOY_ENV=test
VITE_NODE_ENV=production

# 天地图 Token
VITE_TIANDITU_TOKEN=your_tianditu_token_here

# Cesium Ion Token
VITE_CESIUM_ION=your_cesium_ion_token_here

# 浏览器运行时 API 基础地址
# 部署到 Nginx 时保持为空字符串，走同源 /api 代理
VITE_API_BASE_URL=

# 浏览器运行时 IAM 基础地址
# 部署到 Nginx 时保持为空字符串，走同源 /auth、/system 代理
VITE_IAM_BASE_URL=
