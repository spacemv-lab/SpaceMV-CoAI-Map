# 本地开发环境 - 前端 Web 配置模板
# 用途：本地开发调试，Vite 注入环境变量 (VITE_* 前缀)

# 环境标识
VITE_DEPLOY_ENV=local
VITE_NODE_ENV=development

# 天地图 Token 改由 API 下发(GET /api/tile-sources/tianditu-token，读 api.env 的 TIANDITU_DEFAULT_TOKEN)
# 不再需要 VITE_TIANDITU_TOKEN 注入浏览器 bundle

# 浏览器运行时 API 基础地址
# 本地开发保持为空字符串，走 Vite /api 代理
VITE_API_BASE_URL=

# Vite 开发代理目标（仅 dev server 使用，不注入浏览器）
API_PROXY_TARGET=http://localhost:3000

# 浏览器运行时 IAM 基础地址
# 本地开发保持为空字符串，走 Vite /auth、/system 代理
VITE_IAM_BASE_URL=

# Vite 开发代理目标（仅 dev server 使用，不注入浏览器）
IAM_PROXY_TARGET=http://your_iam_host:19001
