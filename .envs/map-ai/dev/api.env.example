# 本地开发环境 - 后端 API 配置模板
# 用途：本地开发调试，连接本地 Docker 容器中的 DB/Redis

# 环境标识
NODE_ENV=development
DEPLOY_ENV=local

# 数据库 - 本地 Docker 容器 (端口 5433)
DATABASE_URL=postgresql://your_user:your_password@localhost:5433/your_database

# Redis - 本地 Docker 容器 (端口 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# Agent - 本地运行
AGENT_BASE_URL=http://localhost:8001
AGENT_TIMEOUT_MS=20000

# API 服务
PORT=3000
STREAM_CHUNK_SIZE=6

# 公开分享 - 拼接分享链接所用的 Web 根地址（生产须为正式 HTTPS 域名）
PUBLIC_WEB_BASE_URL=http://localhost:4200

# IAM 服务地址 - 单点登录认证服务
IAM_BASE_URL=http://your_iam_host:19001

# OpenAI 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URL=
MODEL=gpt-4o-mini

# MinIO Object Storage - 本地 Docker
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=gis-uploads
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# GDAL 解析后端
# local: 使用显式配置的本机 ogr2ogr/ogrinfo 路径
# docker: 使用 Docker / WSL Docker 镜像里的 GDAL，避免在宿主机手动安装
# 推荐配合 docker/infra/docker-compose.yml 中的 gdal-tools 服务使用
GDAL_MODE=docker
GDAL_DOCKER_IMAGE=txwx-gdal-tools:dev
GDAL_DOCKER_USE_WSL=false
GDAL_WSL_DISTRO=Ubuntu
GDAL_WSL_USER=
GDAL_COMMAND_TIMEOUT_MS=120000
GDAL_OGR2OGR_PATH=
GDAL_OGRINFO_PATH=

# 外部数据同步配置 (ADS-B / AIS)
# OpenSky Network - 航空器位置数据 (https://opensky-network.org/)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
# AISStream - 船舶位置数据 (https://aisstream.io/)
AISSTREAM_API_KEY=your_aisstream_api_key
