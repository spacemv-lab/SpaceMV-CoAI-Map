# 本地开发环境 - 后端 API 配置模板
# 用途：本地开发调试，连接本地 Docker 容器中的 DB/Redis

# 环境标识
NODE_ENV=development
DEPLOY_ENV=local

# 数据库 - 本地 Docker 容器 (端口 5433)
DATABASE_URL=postgresql://your_user:your_password@localhost:5433/your_database

# Redis - 本地 Docker 容器 (端口 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# Agent - 本地运行
AGENT_BASE_URL=http://localhost:8001
AGENT_TIMEOUT_MS=20000

# API 服务
PORT=3000
STREAM_CHUNK_SIZE=6

# 公开分享 - 拼接分享链接所用的 Web 根地址（生产须为正式 HTTPS 域名）
PUBLIC_WEB_BASE_URL=http://localhost:4200

# IAM 服务地址 - 单点登录认证服务
IAM_BASE_URL=http://your_iam_host:19001

# OpenAI 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URL=
MODEL=gpt-4o-mini

# MinIO Object Storage - 本地 Docker
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=gis-uploads
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# GDAL:api 镜像已 apt install gdal-bin,容器内自带 ogr2ogr/ogrinfo/gdal_translate(走 PATH)
# (历史 GDAL_MODE=docker + GDAL_DOCKER_USE_WSL 派生 WSL docker 的机制已移除:api 永远
#  跑在自带 GDAL 的镜像里,那条路径不生效)
GDAL_COMMAND_TIMEOUT_MS=120000

# 外部数据同步配置 (ADS-B / AIS)
# OpenSky Network - 航空器位置数据 (https://opensky-network.org/)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
# AISStream - 船舶位置数据 (https://aisstream.io/)
AISSTREAM_API_KEY=your_aisstream_api_key

# 瓦片源凭据加密主密钥(base64 编码的 32 字节随机串);仅 token 存取用,缺则凭据读写报错
# 生成:node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TILE_SOURCE_ENCRYPTION_KEY=your_base64_32byte_key_here

# 天地图平台兜底 token(用户未自配时用);申请 https://lbs.tianditu.gov.cn/
TIANDITU_DEFAULT_TOKEN=your_tianditu_token_here

# TiTiler 栅格瓦片服务地址(浏览器直连取瓦片;api 拼进 TileSource.urlTemplate)
TITILER_BASE_URL=http://localhost:8002

# TiTiler 内部地址(api 容器侧,用于转码后取 /cog/statistics 算真彩色 rescale)
TITILER_INTERNAL_URL=http://host.docker.internal:8002
